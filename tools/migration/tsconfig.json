{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noEmitOnError": true,
    "declaration": true, "outDir": "build", "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
